{
  "type": "object",
  "properties": {
    "job_description": {
      "description": "Job the candidates are compared against",
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "description": "Two to five already-scored blind candidates",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "description": "Caller-supplied id for this candidate",
            "type": "string",
            "minLength": 1
          },
          "skills": {
            "description": "Skills used for scoring",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "years_of_experience": {
            "description": "Total years of professional experience",
            "type": "number"
          },
          "work_history": {
            "description": "Work history without identity fields",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "company": {
                  "description": "Employer or organization name",
                  "type": "string"
                },
                "role": {
                  "description": "Job title or role",
                  "type": "string"
                },
                "duration": {
                  "description": "Employment period, e.g. 'Jan 2020 - Present'",
                  "type": "string"
                },
                "description": {
                  "description": "Summary of responsibilities and achievements",
                  "type": "string"
                }
              },
              "required": [
                "company",
                "role",
                "duration",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "education": {
            "description": "Education history without identity fields",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "institution": {
                  "description": "School, university, or training organization",
                  "type": "string"
                },
                "degree": {
                  "description": "Degree or credential, e.g. 'B.S.' or 'Bootcamp Certificate'",
                  "type": "string"
                },
                "field_of_study": {
                  "description": "Major or field of study, or empty string if not found",
                  "type": "string"
                },
                "duration": {
                  "description": "Study period, e.g. '2016 - 2020'",
                  "type": "string"
                }
              },
              "required": [
                "institution",
                "degree",
                "field_of_study",
                "duration"
              ],
              "additionalProperties": false
            }
          },
          "skills_score": {
            "description": "Skills sub-score from /score",
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "experience_score": {
            "description": "Experience sub-score from /score",
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "education_score": {
            "description": "Education sub-score from /score",
            "type": "number",
            "maximum": 100,
            "minimum": 0
          },
          "summary": {
            "description": "Scoring summary from /score",
            "type": "string"
          }
        },
        "required": [
          "candidate_id",
          "skills",
          "years_of_experience",
          "work_history",
          "education",
          "skills_score",
          "experience_score",
          "education_score",
          "summary"
        ],
        "additionalProperties": false
      },
      "maxItems": 5,
      "minItems": 2
    }
  },
  "required": [
    "job_description",
    "candidates"
  ],
  "additionalProperties": false
}
